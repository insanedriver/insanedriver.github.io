{
  "name": "insanedriver.github.io",
  "version": "1.0.0",
  "description": "Insane Driver Official Website",
  "main": "index.js",
  "scripts": {
    "build": "npm run less:build && npx @11ty/eleventy",
    "less:build": "node scripts/build-css.cjs",
    "watch": "npx @11ty/eleventy --serve & node scripts/build-css.cjs --watch",
    "test": "npm run test:unit && npm run test:photos",
    "test:unit": "node --test tests/*/*.test.cjs",
    "test:photos": "npm run less:build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insanedriver/insanedriver.github.io.git"
  },
  "keywords": [],
  "author": "insanedriver",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/insanedriver/insanedriver.github.io/issues"
  },
  "homepage": "https://insanedriver.com.br",
  "devDependencies": {
    "@11ty/eleventy": "^0.12.1",
    "@playwright/test": "^1.63.0",
    "gray-matter": "4.0.2",
    "html-minifier": "^4.0.0",
    "less": "^4.5.1",
    "liquidjs": "6.4.3"
  }
}
