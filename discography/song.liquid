---
layout: base.html
pagination:
  data: catalog.songs
  size: 1
  alias: song
  addAllPagesToCollections: true
permalink: "discography/{{ song.album.slug }}/{{ song.slug }}/index.html"
page_robots: index, follow
page_id: discography
jspath: js/song
header_img_path: header_4.jpg
og_type: music.song
eleventyComputed:
  page_title: "{{ song.title }}"
  page_header_class: "{% if song.video %}song-title-badge{% endif %}"
  seo_title: "{{ song.title }} Lyrics – Insane Driver"
  page_description: "{% if song.about %}{{ song.about | metaDescription }}{% elsif song.instrumental %}{{ song.title }} is the instrumental track {{ song.position }} of Insane Driver's {{ song.album.year }} album {{ song.album.title }}, hard rock and heavy metal from Brazil.{% else %}{{ 'Lyrics of \"' | append: song.title | append: '\", track ' | append: song.position | append: \" of Insane Driver's \" | append: song.album.year | append: ' album ' | append: song.album.title | append: ' – hard rock, heavy metal and metalcore from São Paulo, Brazil.' | metaDescription }}{% endif %}"
  og_image: "/assets/images/releases/{{ song.cover.file }}"
---
{%- assign release = song.album -%}
<div class="disc-shell disc-page song-page{% if song.video %} song-page--bento{% endif %} cyber-zone" data-disc>
    <div class="cyber-zone-inner">

    {% if song.video %}
    {% include 'discography/song-bento' %}
    {% else %}

    <div class="cyber-panel">
        <div class="cyber-panel-tab"><span class="tab-icon"></span> TRACK::{% if song.position < 10 %}0{% endif %}{{ song.position }}</div>
        <div class="cyber-panel-body cyber-panel-body--disc-release" data-hud="SONG.{{ song.slug | upcase }} // {{ song.album.year }}_">
            <span class="top-accent"></span>
            <span class="corner-tl"></span>
            <span class="corner-tr"></span>
            <span class="corner-bl"></span>
    <article class="disc-release" data-song="{{ song.slug }}">
        <div class="disc-release-art">
            <img src="/assets/images/releases/{{ song.cover.file }}" width="600" height="600" alt="{{ song.cover.alt | escape }}" decoding="async">
            <span class="disc-art-corner" aria-hidden="true"></span>
        </div>
        <div class="disc-release-body">
            <div class="disc-release-heading">
                <span class="disc-eyebrow">Track {% if song.position < 10 %}0{% endif %}{{ song.position }} // {{ song.album.year }}</span>
                <p class="song-album">From the album <a href="{{ song.album.url }}" data-song-album>{{ song.album.title | escape }}</a> ({{ song.album.year }})</p>
                <p class="disc-release-meta">{% if song.instrumental %}Instrumental · {% endif %}{{ song.duration | divided_by: 60 | floor }}:{% assign secs = song.duration | modulo: 60 %}{% if secs < 10 %}0{% endif %}{{ secs }}</p>
            </div>

            <span class="disc-eyebrow song-links-title">Listen to the song</span>
            {% assign release = song.listen %}{% include 'discography/links' %}{% assign release = song.album %}

            {% include 'seo/fans-of' %}
        </div>
    </article>
        </div>
    </div>

    <div class="cyber-separator"></div>

    <div class="cyber-panel">
        <div class="cyber-panel-tab"><span class="tab-icon"></span> {% if song.instrumental %}SONG::INSTRUMENTAL{% else %}SONG::LYRICS{% endif %}</div>
        <div class="cyber-panel-body cyber-panel-body--song" data-hud="{% if song.instrumental %}NO.VOCALS{% else %}LYRICS.{{ song.sections.size }} SECTIONS{% endif %}_">
            <span class="top-accent"></span>
            <span class="corner-tl"></span>
            <span class="corner-tr"></span>
            <span class="corner-bl"></span>
    {% include 'discography/song-lyrics' %}

    {% include 'discography/song-dossier' %}

        </div>
    </div>

    {% endif %}

    {% include 'discography/song-nav' %}

    </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  "name": {{ song.title | jsonify }},
  "url": "https://insanedriver.com.br{{ song.url }}",
  "byArtist": { "@type": "MusicGroup", "name": "Insane Driver", "url": "https://insanedriver.com.br/band/" },
  "inAlbum": { "@type": "MusicAlbum", "name": {{ song.album.title | jsonify }}, "url": "https://insanedriver.com.br{{ song.album.url }}" },
  "duration": "PT{{ song.duration | divided_by: 60 | floor }}M{{ song.duration | modulo: 60 }}S",
  "position": {{ song.position }},
  "image": "https://insanedriver.com.br/assets/images/releases/{{ song.cover.file }}",
  "genre": ["Hard Rock", "Heavy Metal", "Metalcore"],{% if song.sameAs.size > 0 %}
  "sameAs": {{ song.sameAs | jsonify }},{% endif %}
  "recordingOf": {
    "@type": "MusicComposition",
    "name": {{ song.title | jsonify }}{% unless song.instrumental %},
    "lyrics": { "@type": "CreativeWork", "text": {{ song.lyricsText | jsonify }} }{% endunless %}
  }
}
</script>
{% if song.video and song.video.uploadDate %}
{%- capture video_description %}{{ song.video.title }}. A video of {{ song.title }} by Insane Driver, from the {{ song.album.year }} album {{ song.album.title }}.{% endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ song.video.title | jsonify }},
  "description": {{ video_description | jsonify }},
  "thumbnailUrl": "https://i.ytimg.com/vi/{{ song.video.id }}/hqdefault.jpg",
  "uploadDate": "{{ song.video.uploadDate }}",
  "embedUrl": "https://www.youtube-nocookie.com/embed/{{ song.video.id }}"
}
</script>
{% endif %}
{% assign crumb_release = song.album %}{% assign crumb_song = song %}{% include 'seo/breadcrumbs' %}
