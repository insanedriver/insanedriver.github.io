<li>
    <a class="disc-single" href="{{ catalog.links[single.slug].page }}" data-disc-single="{{ single.slug }}">
        <img class="disc-single-art" src="/assets/images/releases/{{ single.cover }}" width="{{ single.coverWidth }}" height="{{ single.coverHeight }}" alt="{{ single.title | escape }} cover" loading="lazy" decoding="async">
        <span class="disc-single-meta">
            <span class="disc-single-title">{{ single.title | escape }}</span>
            <span class="disc-single-year">{{ single.year }}</span>
        </span>
    </a>
</li>
