<section class="photos-instagram" aria-labelledby="photos-instagram-title">
    <div class="photos-section-heading">
        <div><span class="photos-eyebrow">FROM INSTAGRAM</span><h2 id="photos-instagram-title">More from the band<span class="photos-accent">.</span></h2></div>
    </div>
    <a class="photos-instagram-profile" href="https://www.instagram.com/insanedriverid/" target="_blank" rel="noopener noreferrer" aria-label="Visit @insanedriverid on Instagram (opens in a new tab)">@insanedriverid <span aria-hidden="true">&#8599;</span></a>
    {% if instagram.posts.size > 0 %}
    <div class="photos-instagram-grid">
        {% for post in instagram.posts %}
        <a class="photos-instagram-card" href="{{ post.permalink | escape }}" target="_blank" rel="noopener noreferrer" aria-label="View Instagram photo: {{ post.alt | escape }} (opens in a new tab)">
            <img src="{{ post.image | escape }}" alt="{{ post.alt | escape }}" width="600" height="600" loading="lazy" decoding="async">
            <div class="photos-instagram-caption"><time datetime="{{ post.timestamp | escape }}">{{ post.timestamp | date: '%d %b %Y' }}</time><p>{{ post.caption | escape }}</p><span class="photos-instagram-link">View on Instagram &#8599;</span></div>
        </a>
        {% endfor %}
    </div>
    {% else %}
    <p class="photos-instagram-empty">Find more photos and updates on our Instagram.</p>
    {% endif %}
</section>
